# Copy to .env and fill in real values. NEVER commit .env.

# --- Application ---
APP_NAME=India Travel Explorer
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]

# --- Logging ---
LOG_LEVEL=INFO
# true = JSON lines (staging/production); false = readable text (local)
LOG_JSON=false

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travel
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Optional full URL (overrides POSTGRES_* when set), e.g. from Render/Railway
# DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_ECHO=false

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-with-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_RATE_LIMIT=60/minute

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- LLM / RAG ---
FEATURE_PLANNER_ENABLED=true
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_INVALID_JSON_RETRIES=1
LLM_DAILY_REQUEST_LIMIT=20
RAG_MAX_PLACES=20
CHAT_HISTORY_TURNS=6
